{
  "name": "tela-planner",
  "version": "0.1.562",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "node --test tests/*.test.mjs",
    "prebuild": "node scripts/write-version.mjs",
    "build": "vite build && node scripts/build-redirect-bridge.mjs && node scripts/inline-webresource.mjs && node scripts/verify-webresource.mjs",
    "push": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts\\push-dev.ps1 -DeviceCode",
    "psh": "npm run push",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.21.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "clsx": "^2.1.1",
    "docx": "^9.5.1",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  }
}
